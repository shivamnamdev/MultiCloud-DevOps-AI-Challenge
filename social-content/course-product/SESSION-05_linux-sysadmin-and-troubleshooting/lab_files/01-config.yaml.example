# Static IP for a LOCAL VM only. Copy to /etc/netplan/01-config.yaml, then: sudo netplan try
# Change the interface name, the address and the gateway to match `ip a` and `ip route` on your VM.
network:
  version: 2
  ethernets:
    enp0s3:
      dhcp4: false
      addresses: [192.168.0.50/24]
      routes:
        - to: default
          via: 192.168.0.1
      nameservers:
        addresses: [8.8.8.8, 1.1.1.1]
