# Practice foreman for the capstone: Jenkins LTS (Java 21) + Docker CLI + Trivy + Python + the plugins used here.
FROM jenkins/jenkins:lts-jdk21
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip git curl ca-certificates openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'   # practice only: mounted repos belong to your own user
# Docker CLI and Trivy, picked for this machine's CPU type (Intel/AMD or ARM).
RUN set -e; A=$(uname -m); \
    case "$A" in x86_64) DA=x86_64; TA=64bit;; aarch64|arm64) DA=aarch64; TA=ARM64;; esac; \
    curl -fsSL "https://download.docker.com/linux/static/stable/$DA/docker-27.5.1.tgz" | tar -xz -C /tmp && mv /tmp/docker/docker /usr/local/bin/docker && rm -rf /tmp/docker; \
    curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v0.76.2/trivy_0.76.2_Linux-$TA.tar.gz" | tar -xz -C /usr/local/bin trivy
USER jenkins
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt
COPY jenkins.yaml /casc/jenkins.yaml
ENV CASC_JENKINS_CONFIG=/casc/jenkins.yaml
# Practice shortcuts: skip the setup wizard; allow a Git repository given as a local folder path.
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false -Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true"
