// LAB ONLY: shows which disguised copies of a secret are still hidden by masking.
pipeline {
  agent any
  stages {
    stage('Disguises') {
      steps {
        withCredentials([string(credentialsId: 'demo-token', variable: 'TOKEN')]) {
          sh 'echo "plain:   $TOKEN"'
          sh 'echo "base64:  $(printf %s "$TOKEN" | base64)"'
          sh 'echo "reverse: $(printf %s "$TOKEN" | rev)"'
          sh 'echo "spaced:  $(printf %s "$TOKEN" | sed "s/./& /g")"'
          sh 'echo "hex:     $(printf %s "$TOKEN" | od -An -tx1 | tr -d " \n")"'
        }
      }
    }
  }
}
